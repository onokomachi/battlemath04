// BattleMath Online - Firestore Security Rules
//
// デプロイ方法:
//   firebase deploy --only firestore:rules
//   （または Firebase Console → Firestore Database → ルール に貼り付けて「公開」）
//
// コレクション構造:
//   /users/{uid}            - ユーザープロファイル・進捗
//   /rooms/{roomId}         - PvPルーム（参加者のみ更新可）
//   /catwars_rooms/{roomId} - CAT-WARS対戦ルーム（参加者のみ更新可。ticksはRTDB側）
//   /config/{docId}         - ゲーム設定・月次チャンピオン (管理者のみ書込み)
//   /rankings/{docId}       - 月次サブトピック別ランキング
//   /classStatsCache/{docId}- 学校対抗統計の共有キャッシュ

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 管理者判定: 固定の1件(ADMIN_EMAILS/constants.tsと同期すること)に加え、
    // config/admins ドキュメント(管理画面から追加・削除)に載っているメールも管理者として扱う。
    function isAdmin() {
      return request.auth != null
        && (
          request.auth.token.email in ['ono.yosuke@isesaki-school.ed.jp']
          || (
            exists(/databases/$(database)/documents/config/admins)
            && request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails
          )
        );
    }

    // ユーザーデータ: 自分のデータのみ読み書き可 / 管理者は全操作可
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // PvPルーム
    // 重要: update を「参加者のみ」に制限する。
    // 以前は認証済みなら誰でも任意ルームのHP・勝敗を書き換え可能だった（チート可能）。
    match /rooms/{roomId} {

      // 参加者（ホスト or ゲスト）か
      function isParticipant() {
        return request.auth.uid == resource.data.hostId
            || request.auth.uid == resource.data.guestId;
      }

      // 待機中ルームへのゲスト参加: 自分をguestに登録する更新のみ許可
      function isGuestJoin() {
        return resource.data.status == 'waiting'
            && resource.data.guestId == null
            && request.resource.data.guestId == request.auth.uid
            && request.resource.data.hostId == resource.data.hostId;
      }

      // ゾンビルーム掃除（第三者）: 「終了マークのみ」かつ十分に古いルームに限る。
      // クライアントは waiting=10分 / playing=2-3分 で掃除するため、サーバー側は
      // それより緩い下限（waiting 8分 / playing 90秒）で正当な掃除のみ通す。
      function isStaleRoomCleanup() {
        return request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'winnerId'])
            && request.resource.data.status == 'finished'
            && (
              (resource.data.status == 'waiting'
                && resource.data.createdAt != null
                && resource.data.createdAt < request.time - duration.value(8, 'm'))
              || (resource.data.status == 'playing'
                && (
                  (resource.data.hostLastActive != null
                    && resource.data.hostLastActive < request.time - duration.value(90, 's'))
                  || (resource.data.guestLastActive != null
                    && resource.data.guestLastActive < request.time - duration.value(90, 's'))
                ))
            );
      }

      allow read: if request.auth != null;

      // 作成: 自分自身をホストとして登録する場合のみ
      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid;

      allow update: if request.auth != null
        && (isParticipant() || isGuestJoin() || isStaleRoomCleanup() || isAdmin());

      // 参加者のみ削除可能にし、ゾンビルームの蓄積を防止
      allow delete: if request.auth != null
        && (resource.data.hostId == request.auth.uid
            || resource.data.guestId == request.auth.uid
            || resource.data.status == 'finished'
            || isAdmin());
    }

    // CAT-WARS PvPルーム（catwars/net/matchmaking.ts）
    // rooms と同じ考え方: 参加者のみ更新可・ホストのみ作成可・第三者は
    // 十分に古いルームの掃除のみ許可する。tickごとのコマンドはこちらではなく
    // Realtime Database（database.rules.json）に流れる。
    match /catwars_rooms/{roomId} {

      function isParticipant() {
        return request.auth.uid == resource.data.hostId
            || request.auth.uid == resource.data.guestId;
      }

      // 待機中ルームへのゲスト参加: guest欄を自分の情報で埋める更新のみ許可
      function isGuestJoin() {
        return resource.data.status == 'waiting'
            && resource.data.guestId == null
            && request.resource.data.guestId == request.auth.uid
            && request.resource.data.hostId == resource.data.hostId;
      }

      // ホストが対戦開始する更新（status: waiting→playing, seedの確定）のみ許可
      function isHostStart() {
        return request.auth.uid == resource.data.hostId
            && resource.data.status == 'waiting'
            && request.resource.data.status == 'playing';
      }

      // ゾンビルーム掃除（第三者）: rooms と同じ下限（waiting 8分）
      function isStaleRoomCleanup() {
        return request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'winner'])
            && request.resource.data.status == 'finished'
            && resource.data.status == 'waiting'
            && resource.data.createdAt != null
            && resource.data.createdAt < request.time - duration.value(8, 'm');
      }

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid;

      allow update: if request.auth != null
        && (isParticipant() || isGuestJoin() || isHostStart() || isStaleRoomCleanup() || isAdmin());

      allow delete: if request.auth != null
        && (resource.data.hostId == request.auth.uid
            || resource.data.guestId == request.auth.uid
            || resource.data.status == 'finished'
            || isAdmin());
    }

    // ゲーム設定: 誰でも読める / 管理者のみ書込み可
    // ただし admins ドキュメント(管理者メール一覧)はログイン済みユーザーのみ読める(メールアドレス漏洩防止)。
    match /config/{docId} {
      allow read: if docId == 'admins' ? request.auth != null : true;
      allow write: if isAdmin();
    }

    // 学校対抗統計キャッシュ: 認証ユーザーが読み書き可（派生データのみ）
    // 以前はルール未定義のため常に拒否され、開くたびに全ユーザーscanが走っていた
    match /classStatsCache/{docId} {
      allow read, write: if request.auth != null;
    }

    // ランキング (月次サブトピック別): 自分のスコアのみ作成・更新可
    // ドキュメントID: {YYYY-MM}_{subtopic}_{uid}
    // 注: 個別ランキングのUIは撤去済み。過去データ互換のためルールのみ残す。
    match /rankings/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // 学習分析の日次サマリ: 児童は自分のぶんのみ書込可(1セッション1回のsetDoc merge)。
    // 読み取りは管理者のみ(他の児童の成績は児童からは見えない)。
    // ドキュメントID: {uid}_{YYYY-MM-DD}
    match /dailySummaries/{docId} {
      allow read: if isAdmin();
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
